# Romance Reader Intelligence Environment Configuration

# Server Settings
MCP_SERVER_NAME=romance-reader-intelligence
MCP_SERVER_VERSION=0.1.0
MCP_TRANSPORT=stdio
PORT=8000
HOST=127.0.0.1

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Data Paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
DATABASE_PATH=data/processed/romance_books.db

# Open Library Secondary API Settings
OPENLIBRARY_USER_AGENT=RomanceReaderIntelligence/0.1.0 (academic-research@example.com)
OPENLIBRARY_RATE_LIMIT_DELAY=1.0

# Optional External LLM Integration (System works 100% locally without external keys)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
